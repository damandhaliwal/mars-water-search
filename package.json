{
  "name": "mars-water-search-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src",
    "test": "vitest run --exclude \"src/test/browser/**\"",
    "test:browser": "playwright test --config src/test/browser.config.ts --project network-fixtures",
    "test:browser:live": "playwright test --config src/test/browser.config.ts --project local-backend"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
